{
  "permissions": {
    "allow": [
      "Bash(tools/bq/bq-query:*)",
      "Bash(./tools/bq/bq-query:*)",
      "Bash(bq ls:*)",
      "Bash(bq show:*)",
      "Bash(bq head:*)",
      "Bash(gcloud auth list:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud projects describe:*)",
      "Bash(bash .claude/hooks/cloud-auth.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-auth.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
